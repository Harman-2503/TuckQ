# Cloudflare deploy target
CLOUDFLARE_WORKER_NAME=tuckq
CLOUDFLARE_D1_DATABASE_NAME=tuckq-db
CLOUDFLARE_D1_DATABASE_ID=replace-with-cloudflare-d1-database-id

# Microsoft Entra ID / Azure SSO
AZURE_TENANT_ID=replace-with-tenant-id
AZURE_CLIENT_ID=replace-with-client-id
AZURE_CLIENT_SECRET=replace-with-client-secret
AZURE_SESSION_SECRET=replace-with-long-random-secret
AZURE_REDIRECT_URI=https://tuckq.yourschool.edu/api/auth/azure/callback

# Optional role mapping
AZURE_ADMIN_EMAILS=
AZURE_OPERATOR_EMAILS=
AZURE_TEACHER_EMAILS=
AZURE_ADMIN_GROUP_IDS=
AZURE_OPERATOR_GROUP_IDS=
AZURE_TEACHER_GROUP_IDS=

# Microsoft Graph student master sync
# Preferred: paste the SharePoint/OneDrive sharing URL for the one Excel file.
GRAPH_STUDENT_MASTER_SHARE_URL=
# Alternative: configure a specific drive item.
GRAPH_STUDENT_MASTER_DRIVE_ID=
GRAPH_STUDENT_MASTER_ITEM_ID=
# Alternative: configure a site and file path.
GRAPH_STUDENT_MASTER_SITE_ID=
GRAPH_STUDENT_MASTER_PATH=
TUCKQ_GRAPH_SYNC_KEY=replace-with-long-random-admin-sync-key

# Optional manual bill email sending through Resend
MAIL_MODE=draft
RESEND_API_KEY=
MAIL_FROM=TuckQ <tuckq@yourschool.edu>
